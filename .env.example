# KJScreener — example environment file
# Copy this to `.env` and fill in your own values. `.env` is git-ignored,
# so your secrets never get committed. Never share your real `.env`.

# ── LLM / AI agent (Screeni) ──────────────────────────────────────────────
# API key used by the AI-native tab. Works for Groq / OpenAI / Anthropic /
# any OpenAI-compatible provider configured in KJScreener.yaml.
KJScreener_API_KEY=

# Optional provider-specific fallbacks (only set the one you use):
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Kite (Zerodha) MCP integration ────────────────────────────────────────
# Kite login happens through the browser auth flow; no API secret is stored here.
# KJSCREENER_KITE_ENABLED=true
# KJSCREENER_KITE_URL=https://mcp.kite.trade/mcp

# ── Runtime mode (usually set automatically; leave commented) ─────────────
# KJScreener_GUI=TRUE      # set by the Streamlit app
# KJScreener_DOCKER=TRUE   # set inside the Docker image
